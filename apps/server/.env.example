# Опционально: включает реальный ИИ-перевод и сводки смены через Claude.
# Без ключа приложение всё равно полностью работает: рация, каналы,
# транскрипция через Web Speech API в браузере — всё в реальном времени.
# Только перевод будет помечен как недоступный, а сводка смены соберётся
# простым списком реплик вместо связного текста.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

PORT=8787
