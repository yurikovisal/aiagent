# MEZA AI — скопируй в .env и подставь значения
POSTGRES_USER=meza
POSTGRES_PASSWORD=meza_dev_change_me
POSTGRES_DB=meza_ai
POSTGRES_PORT=5432

REDIS_PORT=6379
MINIO_ROOT_USER=meza
MINIO_ROOT_PASSWORD=meza_minio_change_me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

API_PORT=8000
API_SECRET_KEY=change-me-to-a-long-random-string
FERNET_KEY=

# Ollama (опционально на хосте / в GPU-стеке)
OLLAMA_BASE_URL=http://ollama:11434
LLM_MODEL=qwen3:14b-instruct-q4_K_M
# true = mock-ответы без GPU (удобно для smoke-тестов)
LLM_MOCK=false

# Langfuse (опционально)
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_NEXTAUTH_SECRET=langfuse-nextauth-change-me
LANGFUSE_SALT=langfuse-salt-change-me

# Traefik
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080
