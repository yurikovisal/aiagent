# ---------------------------------------------------------------------------
# MEZA — ATON+ internal AI operating system
# Copy to .env and adjust. NEVER commit real credentials.
# ---------------------------------------------------------------------------
APP_ENV=development
APP_NAME=MEZA
LOG_LEVEL=INFO

# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_MINUTES=720
COOKIE_SECURE=false

# Database: PostgreSQL (primary) or SQLite (single-user fallback)
DATABASE_URL=postgresql+asyncpg://meza:meza_dev_password@localhost:5432/meza
# DATABASE_URL=sqlite+aiosqlite:///./storage/meza.db

# Optional queue/cache. Leave empty to use the DB-backed job queue.
REDIS_URL=

# Local LLM (Ollama). LLM_PROVIDER=ollama|none
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text
LLM_TIMEOUT_SECONDS=120

# Storage
UPLOAD_DIR=./storage/uploads
INBOX_DIR=./storage/inbox
BACKUP_DIR=./storage/backups
MAX_UPLOAD_MB=50

# Agent execution budget
MAX_AGENT_STEPS=8
MAX_AGENT_TOOL_CALLS=40
MAX_AGENT_HANDOFFS=6
AGENT_TIMEOUT_SECONDS=90

# HTTP
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=240

# First admin (created by `make seed` / `meza create-admin` if missing)
ADMIN_EMAIL=admin@atonplus.internal-demo.kz
ADMIN_PASSWORD=change-me

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
